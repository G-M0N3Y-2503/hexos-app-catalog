{
  "version": 6,
  "script": {
    "version": "1.1.0",
    "changeLog": "Upgraded to V6 install script format with hooks section for SSO support"
  },
  "requirements": {
    "locations": [
      "ApplicationsPerformance",
      "Photos"
    ],
    "specifications": [
      "2CORE",
      "256MB"
    ],
    "permissions": [
      "READ_WRITE_LOCATIONS"
    ],
    "ports": [
      2283
    ]
  },
  "ensure_directories_exists": [
    {
      "path": "$LOCATION(ApplicationsPerformance)"
    },
    {
      "path": "$LOCATION(Photos)",
      "network_share": true
    },
    {
      "path": "$LOCATION(Photos)/immich",
      "owner": {
        "user": "apps"
      },
      "snapshot": {
        "id": "data"
      }
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/immich/postgres_data",
      "owner": {
        "user": "netdata",
        "group": "docker"
      },
      "snapshot": {
        "id": "db"
      }
    }
  ],
  "app_values": {
    "release_name": "immich",
    "immich": {
      "enable_ml": true,
      "ml_image_selector": "ml_image",
      "db_password": "$RANDOM_STRING(16)",
      "redis_password": "$RANDOM_STRING(16)",
      "log_level": "log",
      "hugging_face_endpoint": "",
      "db_storage_type": "SSD",
      "additional_envs": []
    },
    "network": {
      "web_port": {
        "bind_mode": "published",
        "port_number": "$PORT(2283)"
      }
    },
    "storage": {
      "data": "$HOST_PATH($LOCATION(Photos)/immich)",
      "ml_cache": {
        "type": "temporary"
      },
      "postgres_data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/immich/postgres_data)"
    },
    "resources": {
      "limits": {
        "cpus": 2,
        "memory": "$MEMORY(10%, 4096)"
      },
      "gpus": "$GPU_CONFIG()"
    }
  },
  "hooks": [
    {
      "id": "enable-sso",
      "title": "Enable SSO with Authentik",
      "description": "Creates an OAuth2 client in Authentik and configures Immich to sign in via it.",
      "events": [
        "userAction"
      ],
      "kind": "connect",
      "conditions": [
        {
          "role": "visibility",
          "type": "appInstalled",
          "app": "authentik"
        }
      ],
      "rerun": "idempotent",
      "script": "immich/immich_sso.ts",
      "entrypoint": "afterInstall",
      "timeout": 300,
      "retries": 2,
      "surfaces": [
        "card"
      ]
    }
  ]
}
