{
  "version": 6,
  "script": {
    "version": "1.0.0",
    "changeLog": "Initial script: library in app storage, all of Photos scanned, CPU limit sized to the server, first-run setup, and optional photo and video tools"
  },
  "requirements": {
    "locations": [
      "ApplicationsPerformance",
      "ApplicationsCapacity",
      "Photos"
    ],
    "specifications": [
      "2CORE",
      "2GBRAM"
    ],
    "permissions": [
      "READ_WRITE_LOCATIONS"
    ],
    "ports": [
      30509
    ]
  },
  "ensure_directories_exists": [
    {
      "path": "$LOCATION(ApplicationsPerformance)"
    },
    {
      "path": "$LOCATION(ApplicationsCapacity)"
    },
    {
      "path": "$LOCATION(Photos)",
      "network_share": true
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/photostructure/config",
      "owner": {
        "user": "apps"
      },
      "snapshot": {
        "id": "config"
      }
    },
    {
      "path": "$LOCATION(ApplicationsPerformance)/photostructure/cache",
      "owner": {
        "user": "apps"
      }
    },
    {
      "path": "$LOCATION(ApplicationsCapacity)/photostructure/library",
      "owner": {
        "user": "apps"
      },
      "snapshot": {
        "id": "library"
      }
    }
  ],
  "app_values": {
    "photostructure": {
      "additional_envs": [
        {
          "name": "PS_PICK_PLAN_ON_WELCOME",
          "value": "false"
        }
      ]
    },
    "storage": {
      "library": "$HOST_PATH($LOCATION(ApplicationsCapacity)/photostructure/library)",
      "config": "$HOST_PATH($LOCATION(ApplicationsPerformance)/photostructure/config)",
      "cache": "$HOST_PATH($LOCATION(ApplicationsPerformance)/photostructure/cache)",
      "additional_storage": [
        "$MOUNTED_HOST_PATH($LOCATION(Photos), /photos)"
      ]
    },
    "network": {
      "web_port": {
        "bind_mode": "published",
        "port_number": 30509
      }
    },
    "resources": {
      "limits": {
        "cpus": "$CPUS(75%, 2)",
        "memory": "$MEMORY(10%, 4096)"
      }
    }
  },
  "hooks": [
    {
      "id": "configure-photostructure",
      "title": "Pre-configure PhotoStructure",
      "description": "Setting up PhotoStructure",
      "events": [
        "onAfterInstall"
      ],
      "script": "photostructure/photostructure_hook.ts",
      "entrypoint": "afterInstall",
      "timeout": 300,
      "optional": true,
      "retries": 0,
      "userOptional": {
        "description": "Completes first-run setup so PhotoStructure starts importing your Photos folder. HexOS accepts the PhotoStructure EULA on your behalf.",
        "default": true,
        "link": {
          "url": "https://photostructure.com/legal/eula/",
          "label": "Learn more"
        }
      }
    },
    {
      "id": "install-photostructure-tools",
      "title": "Install HEIC and video support",
      "description": "Installing photo and video tools",
      "events": [
        "onAfterInstall"
      ],
      "script": "photostructure/photostructure_hook.ts",
      "entrypoint": "installTools",
      "timeout": 900,
      "optional": true,
      "retries": 0,
      "userOptional": {
        "description": "Downloads free, open-source tools so PhotoStructure can import HEIC photos and videos. These tools may carry patent licensing requirements. I accept responsibility for any applicable patent licenses.",
        "default": false,
        "link": {
          "url": "https://photostructure.com/getting-started/media-codec-support/",
          "label": "Learn more"
        }
      }
    }
  ]
}
