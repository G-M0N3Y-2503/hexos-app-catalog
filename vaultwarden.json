{
  "version": 4,
  "script": {
    "version": "1.0.0",
    "changeLog": "initial"
  },
  "requirements": {
    "locations": ["ApplicationsPerformance"],
    "specifications": ["2CORE", "1GB"],
    "permissions": ["READ_WRITE_LOCATIONS"],
    "ports": [30032]
  },
  "installation_questions": [
    {
      "question": "Timezone",
      "description": "Used for logs and scheduled tasks (e.g. Europe/Brussels).",
      "type": "text",
      "key": "timezone",
      "required": false,
      "default": "Etc/UTC"
    },
    {
      "question": "WebUI Port",
      "description": "Port Vaultwarden listens on.",
      "type": "number",
      "key": "web_port",
      "required": true,
      "default": 30032
    },
    {
      "question": "Public Domain",
      "description": "The full external URL clients will use, including the https:// scheme and no trailing slash - e.g. https://vault.yourdomain.tld (not just vault.yourdomain.tld).",
      "type": "text",
      "key": "domain",
      "required": true,
      "placeholder": "https://vault.yourdomain.tld"
    },
    {
      "question": "Admin Token",
      "description": "Custom token to log into /admin. Should be at least 64 random characters - HexOS cannot enforce a minimum length here, so paste a long random value yourself if you want a specific one. Leave blank to auto-generate a secure 64-character token. You can blank this out later in TrueNAS to disable the admin portal entirely.",
      "type": "text",
      "key": "admin_token",
      "required": false,
      "default": "$RANDOM_STRING(64)"
    }
  ],
  "ensure_directories_exists": [
    { "path": "$LOCATION(ApplicationsPerformance)" },
    { "path": "$LOCATION(ApplicationsPerformance)/vaultwarden/data", "snapshot": { "id": "data" } },
    { "path": "$LOCATION(ApplicationsPerformance)/vaultwarden/postgres", "snapshot": { "id": "postgres_data" } }
  ],
  "app_values": {
    "TZ": "$QUESTION(timezone)",
    "vaultwarden": {
      "postgres_image_selector": "postgres_18_image",
      "db_password": "$RANDOM_STRING(32)",
      "admin_token": "$QUESTION(admin_token)",
      "enable_websocket": true,
      "additional_envs": [
        {
          "name": "SIGNUPS_ALLOWED",
          "value": "true"
        }
      ]
    },
    "run_as": {
      "user": 568,
      "group": 568
    },
    "network": {
      "web_port": {
        "bind_mode": "published",
        "port_number": "$QUESTION(web_port)"
      },
      "certificate_id": null,
      "domain": "$QUESTION(domain)",
      "networks": []
    },
    "storage": {
      "data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/vaultwarden/data)",
      "postgres_data": "$HOST_PATH($LOCATION(ApplicationsPerformance)/vaultwarden/postgres)"
    },
    "labels": [
      {
        "key": "homepage.group",
        "value": "Infrastructure",
        "containers": ["vaultwarden"]
      },
      {
        "key": "homepage.name",
        "value": "Vaultwarden",
        "containers": ["vaultwarden"]
      },
      {
        "key": "homepage.icon",
        "value": "vaultwarden.png",
        "containers": ["vaultwarden"]
      },
      {
        "key": "homepage.href",
        "value": "$QUESTION(domain)",
        "containers": ["vaultwarden"]
      },
      {
        "key": "homepage.description",
        "value": "Password Manager",
        "containers": ["vaultwarden"]
      }
    ],
    "resources": {
      "limits": {
        "cpus": 2,
        "memory": 1024
      }
    }
  }
}
